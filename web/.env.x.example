# X bot — copy to web/.env.x (gitignored, auto-loaded by career:x:* scripts)
# See .cursor/career/content/x/phase0-setup.md

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# LLM (pick one)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# XAI_API_KEY=

# Safety flags — week 1 defaults
X_DRY_RUN=true
X_AUTO_POST=false
X_MAX_POSTS_PER_DAY=4
X_MAX_QUOTE_TAKES_PER_DAY=2
X_MAX_RETWEETS_PER_DAY=1
X_WOEID=1
X_PT_BR_WEEKDAY=1

# Image posts (requires media.write — re-run career:x:setup after enabling)
X_MEDIA_ENABLED=false
X_IMAGE_POSTS_PER_DAY=1
X_SCREENSHOT_ENABLED=false

# Notion content hub (optional — see content/notion-hub.md)
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_ENABLED=true
